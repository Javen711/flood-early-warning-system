# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real .env file -- it's already in .gitignore.

DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL connection
DB_NAME=afews_db
DB_USER=afews_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Frontend origin allowed to call this API (Phase 7 React dashboard)
CORS_ALLOWED_ORIGINS=http://localhost:3000
